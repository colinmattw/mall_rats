{
  "name": "mall-rats",
  "private": true,
  "version": "0.1.0",
  "description": "Mall Rats - a stylish skateboarding endless runner set inside an exaggerated shopping mall.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sim:drops": "vitest run src/engine/dropDirector.sim.test.ts --reporter=verbose",
    "report:economy": "vitest run src/economy/economyReport.test.ts --reporter=verbose",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
